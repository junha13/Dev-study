<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Insert title here</title>
<style type="text/css">
	header,section,footer,aside,nav,article,figure,figcaption,hgroup{
  		display: block;
  		text-align: center;
  	}
	table{
		border: 1px solid;
		width: 960px;
	}
	td{
		width: 200px;
	}
	header{
		height: 80px;
		margin: 5px;
		padding: 10px;
		background: #cccccc;
