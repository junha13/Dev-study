<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mapper-requestlog">
	<insert id="insertDB" parameterType="lx.edu.springmvc.vo.RequestLogVO">
		insert into
		request_log(req_class, req_method, req_time) 
		values(#{reqClass}, #{reqMethod}, current_timestamp)
	</insert>

	
	<!-- 하나는 emp, 하나는 emplist 지만 resultType은 resultType="mybatis.Emp" 이렇게 동일하게 써도 됨 -->

</mapper>